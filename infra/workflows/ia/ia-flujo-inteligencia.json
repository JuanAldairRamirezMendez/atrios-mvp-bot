    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prev = $('Prompt del sistema').first().json;\n\nconst texto = (resp.candidates?.[0]?.content?.parts?.[0]?.text || '').trim();\nconst derivar = texto === '' || texto.includes('DERIVAR_HUMANO');\n\nconst estado = { ...prev.estado };\nestado.historial = [\n  ...(estado.historial || []),\n  { rol: 'usuario', texto: prev.mensaje },\n  { rol: 'bot', texto }\n].slice(-10);\n\nif (!derivar) {\n  estado.saludado = true;\n  if (estado.paso === 'inicio') estado.paso = 'menu';\n}\nestado.actualizado = new Date().toISOString();\n\nreturn [{\n  json: {\n    telefono: prev.telefono,\n    mensaje: prev.mensaje,\n    respuesta: derivar ? null : texto,\n    derivar,\n    estado\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
