        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  systemInstruction: {\n    parts: [{ text: $json.system_prompt + \"\\n\\nESTADO ACTUAL DE LA CONVERSACIÓN: \" + JSON.stringify($json.estado) }]\n  },\n  contents: [{ role: \"user\", parts: [{ text: $json.mensaje }] }],\n  generationConfig: { temperature: 0.4, maxOutputTokens: 500 }\n}) }}",
