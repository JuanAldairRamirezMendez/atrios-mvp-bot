        "jsCode": "const base = $('Prompt del sistema').first().json;\nconst intento = $runIndex + 1; // 1, 2, 3: cuántas veces ha fallado\nconst raw = JSON.stringify($json);\nconst esRateLimit = /429|RESOURCE_EXHAUSTED|rate limit/i.test(raw);\nconst reintentar = esRateLimit && intento < 3;\n\nreturn [{ json: { ...base, intento, esRateLimit, reintentar } }];"
      },
