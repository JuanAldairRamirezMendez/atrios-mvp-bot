      "parameters": {
        "jsCode": "const entrada = $('When Executed by Another Workflow').first().json;\nlet guardado = $input.first().json.estado;\n\n// Redis devuelve texto, hay que convertirlo a objeto\nif (typeof guardado === 'string') {\n  try { guardado = JSON.parse(guardado); } catch (e) { guardado = null; }\n}\n\nconst esNuevo = !guardado;\nconst estado = guardado || {\n  paso: 'inicio',\n  saludado: false,\n  intentos: 0,\n  historial: [],\n  actualizado: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    telefono: entrada.telefono,\n    mensaje: entrada.mensaje,\n    esNuevo,\n    estado\n  }\n}];"
      },
