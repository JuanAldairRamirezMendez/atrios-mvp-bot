# ============================================
# ATRIOS MVP — Variables de Entorno
# ============================================
# Copiar este archivo a .env y completar con valores reales
# NUNCA subir .env al repositorio
# ============================================

# --- n8n ---
# Clave de encriptación (mínimo 32 caracteres aleatorios)
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Redis ---
# Password para Redis (usar algo seguro)
REDIS_PASSWORD=

# --- Zona Horaria ---
GENERIC_TIMEZONE=America/Lima