      "id": "init-state",
      "name": "Init State (No History)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst stateData = items[0].json;\nlet history = [];\nlet retryCount = 0;\n\nif (stateData && stateData.history) {\n  history = JSON.parse(stateData.history);\n  retryCount = parseInt(stateData.retry_count) || 0;\n}\n\nreturn [{\n  json: {\n    phone: $('Extract Message Data').item.json.phone,\n    message_text: $('Extract Message Data').item.json.message_text,\n    history: history,\n    retry_count: retryCount\n  }\n}];"
      },
      "id": "build-context",
      "name": "Build Context for Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"contents\": [{ \"parts\": [{ \"text\": $('Build Context for Gemini').item.json.message_text }] }], \"systemInstruction\": { \"parts\": [{ \"text\": 'Eres un asistente de Atrios, empresa de seguridad electrónica. Tu trabajo es: 1) Responder consultas sobre cámaras, alarmas, control de acceso. 2) Extraer datos del prospecto: nombre, empresa, teléfono, email, tipo de servicio de interés, presupuesto aproximado. 3) Si el usuario confirma que quiere una cotización formal, indica que un asesor se contactará. 4) Responde SIEMPRE en español, de forma profesional y concisa. 5) Devuelve un JSON con: { \"response\": \"texto para el usuario\", \"lead_data\": { \"name\": \"\", \"company\": \"\", \"email\": \"\", \"phone\": \"\", \"service\": \"\", \"budget\": \"\" }, \"intent\": \"cotizacion|info|no_interesado|humano\", \"confidence\": 0.0-1.0 }' }] } } } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "call-gemini",
      "name": "Call Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1780, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst candidates = response.candidates || [];\nif (candidates.length === 0) {\n  throw new Error('Gemini returned no candidates');\n}\nconst text = candidates[0].content.parts[0].text;\nlet parsed;\ntry {\n  const jsonMatch = text.match(/\\{[^]*\\}/);\n  parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : { response: text, lead_data: {}, intent: 'info', confidence: 0.5 };\n} catch (e) {\n  parsed = { response: text, lead_data: {}, intent: 'info', confidence: 0.3 };\n}\nreturn [{ json: parsed }];"
      },
      "id": "parse-gemini",
      "name": "Parse Gemini Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.confidence }}",
              "operation": "gte",
              "value2": 0.7
            }
          ]
        }
      },
      "id": "check-confidence",
      "name": "Confidence >= 0.7?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v18.0/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.WHATSAPP_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messaging_product\": \"whatsapp\", \"to\": $('Extract Message Data').item.json.phone, \"type\": \"text\", \"text\": { \"body\": $json.response } } }}"
      },
      "id": "send-whatsapp-reply",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2440, 200]
