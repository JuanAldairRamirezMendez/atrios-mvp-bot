    {
      "parameters": {
        "jsCode": "const respuestaZoho = $input.first().json;\nconst datosLead = $('Preparar Datos Lead').first().json;\n\nconst errorLog = {\n  nivel: 'WARN',\n  tipo: 'ERROR_VALIDACION_ZOHO',\n  fecha: new Date().toISOString(),\n  telefono: datosLead.telefono,\n  detalle: respuestaZoho.error || respuestaZoho.message || respuestaZoho.data?.[0]?.message || 'Fallo de validación de campos en Zoho CRM',\n  codigo: respuestaZoho.code || respuestaZoho.data?.[0]?.code || 'VALIDATION_FAILED'\n};\n\nconsole.warn('⚠️ [AUDITORIA ATRIOS] Error al insertar en Zoho CRM:', JSON.stringify(errorLog));\n\nreturn [{\n  json: {\n    ...datosLead,\n    zoho_log: errorLog\n  }\n}];"
      },
