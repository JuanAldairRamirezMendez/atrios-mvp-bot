    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst base = $('Prompt del sistema').first().json;\n\nconst estado = {\n  ...base.estado,\n  paso: 'Requiere Humano',\n  intentos: src.intento ?? 0,\n  actualizado: new Date().toISOString()\n};\nestado.historial = [\n  ...(estado.historial || []),\n  { rol: 'usuario', texto: base.mensaje }\n].slice(-10);\n\nreturn [{\n  json: {\n    telefono: base.telefono,\n    mensaje: base.mensaje,\n    respuesta: 'Gracias por escribirnos. Un asesor de Atrios te atenderá en breve para ayudarte personalmente.',\n    derivar: true,\n    estado\n  }\n}];"
      },
