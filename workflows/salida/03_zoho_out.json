    {
      "parameters": {
        "jsCode": "// Recuperar la respuesta generada por la IA (de 'Procesar respuesta' o 'Preparar derivación')\nlet origen = {};\ntry {\n  const deriv = $('Preparar derivación').last();\n  if (deriv && deriv.json && deriv.json.derivar) {\n    origen = deriv.json;\n  } else {\n    origen = $('Procesar respuesta').last().json;\n  }\n} catch (e) {\n  origen = $('Procesar respuesta').first()?.json || $('Preparar derivación').first()?.json || {};\n}\n\nconst telefono = String(origen.telefono || '').replace(/[^0-9]/g, '');\nconst mensaje_final = origen.respuesta || 'Gracias por comunicarte con Atrios. Un asesor te atenderá a la brevedad.';\nconst derivar = Boolean(origen.derivar);\n\nreturn [{\n  json: {\n    telefono,\n    mensaje_final,\n    derivar,\n    Last_Name: `Prospecto WhatsApp ${telefono}`,\n    Company: 'Particular - Atrios [TEST]',\n    Phone: telefono,\n    Street: 'Lima, Perú',\n    Lead_Status: derivar ? 'Atención Urgente' : 'No Contactado',\n    Description: `Servicio: Seguridad Electrónica | Derivación Humana: ${derivar ? 'SÍ' : 'NO'} | Origen: Bot WhatsApp Atrios`\n  }\n}];"
      },
